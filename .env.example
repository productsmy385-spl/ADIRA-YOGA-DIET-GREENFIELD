# ---------------------------------------------------------------------------
# Adira — environment template
# ---------------------------------------------------------------------------
# Copy to .env.local for local development. NEVER commit .env.local, and never put a
# real secret in this file — it is committed, and it is the documentation, not the
# configuration.
#
# Every key below is validated at boot by src/lib/env-schema.ts. A missing or malformed
# value fails startup with the key named, rather than throwing on whichever request
# first happens to need it.
#
# Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------


# ---- Required: database ----------------------------------------------------

# Railway PostgreSQL connection string. Load-bearing for every request.
# In Railway, reference the database service rather than pasting a literal:
#   ${{ Postgres.DATABASE_URL }}
#
# INTERNAL vs PUBLIC — Railway gives the Postgres service two connection strings, and
# picking the wrong one fails in a way that does not name the cause:
#
#   DATABASE_URL         host is postgres.railway.internal
#                        Railway's PRIVATE network. Resolves only from inside Railway.
#                        Correct for the deployed app service (faster, no egress cost).
#                        From a laptop it fails with ENOTFOUND — the host does not exist
#                        outside Railway, so the error looks like a broken DNS setup
#                        rather than the wrong variable.
#
#   DATABASE_PUBLIC_URL  host is <something>.proxy.rlwy.net:<port>
#                        Reachable from anywhere. This is the one to put in .env.local
#                        for local development and for running `npm run migrate` from
#                        your own machine.
#
# Find both in the Railway dashboard: Postgres service -> Variables tab.
DATABASE_URL=postgresql://postgres:password@localhost:5432/adira

# Optional. PEM-encoded CA certificate for full TLS verification of the database
# connection. Railway's certificates do not chain to a public CA, so leaving this unset
# means the connection is encrypted but unverified. Set it when you have the cert.
# DATABASE_CA_CERT=


# ---- Required: session secrets ---------------------------------------------
# TWO separate secrets, because Adira has two identity domains (decisions/ADR-001).
# They MUST differ — boot fails if they match. Identical secrets would let a tenant
# session cookie be re-signed as a platform-owner cookie.

# Signs TENANT sessions: org owner, admin/consultant, customer.
SESSION_SECRET=replace-me-with-32-plus-random-bytes-aaaaaaaa

# Signs PLATFORM OWNER sessions. Never reuse SESSION_SECRET here.
OWNER_SESSION_SECRET=replace-me-with-32-plus-random-bytes-bbbbbbbb


# ---- Required: cron ---------------------------------------------------------

# Bearer token Railway Cron presents to /api/cron/* routes. Those routes drain the job
# queue and are unauthenticated apart from this, so treat it as a production credential.
CRON_SECRET=replace-me-with-32-plus-random-bytes-cccccccc


# ---- Required: application --------------------------------------------------

# Absolute origin. Used for WebAuthn relying-party checks — a mismatch here will make
# passkey registration fail with an error that does not obviously point back to this
# variable — and for absolute links in email and reports.
APP_URL=http://localhost:3000

# Public equivalents. NEXT_PUBLIC_* values are compiled into the browser bundle, so
# treat them as published. Never put a secret behind this prefix.
NEXT_PUBLIC_APP_NAME=Adira
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ---- Phase 2: OTP delivery (Resend) -----------------------------------------
# Optional until Phase 2 implements authentication.

# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# OTP_FROM_EMAIL=no-reply@example.com


# ---- Phase 12: ImageKit ------------------------------------------------------
# Optional until Phase 12 implements media.
# The PRIVATE key must never reach the browser — uploads are authorised server-side.

# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_PRIVATE_KEY=
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
#
# All three are required together. The public key is handed to the browser at request
# time rather than inlined as NEXT_PUBLIC_, so one build can serve staging and
# production against different ImageKit accounts.


# ---- Testing -----------------------------------------------------------------
# Integration tests TRUNCATE every table. Point this at a THROWAWAY database only —
# never at development or production data. Unset means DB-dependent suites skip.

# SQL_TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/adira_test
